# Copy to .env for local runs. Never commit real values.

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Owner's personal WhatsApp number, international format without "+" (e.g. 972501234567)
OWNER_WHATSAPP_NUMBER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Shopify (Admin API access token with read_orders only)
SHOPIFY_STORE=avora-il.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# New Shopify apps (Dev Dashboard, 2026+) have no permanent token: leave SHOPIFY_ACCESS_TOKEN empty and set these two.
# The bot gets a short-lived token with the client credentials grant and refreshes it automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Numbers the bot never answers automatically (family, friends, suppliers), comma-separated.
# Their messages are forwarded to OWNER_WHATSAPP_NUMBER only. Example: 972501234567,0521234567
BOT_IGNORE_NUMBERS=

PORT=3000

# ---- Optional ----
# NODE_ENV=production            # hides message bodies in logs
# WHATSAPP_DRY_RUN=true          # log outgoing messages instead of sending
# WHATSAPP_GRAPH_VERSION=v23.0
# CLAUDE_EFFORT=low              # low | medium | high | none
# CLAUDE_MAX_TOKENS=2000
# SHOPIFY_API_VERSION=2026-07
# OWNER_NOTIFY_TEMPLATE=         # Meta-approved utility template for owner alerts (see README)

# Live-site sync (v1.1) - prices, product FAQ and policies come from the website
# SITE_URL=https://avora-il.com
# SITE_SYNC_HOURS=6
# SITE_CACHE_FILE=data/site-cache.json   # last good copy on disk ('' to disable)

# After a hand-off to a human (v1.1)
HANDOFF_QUIET_MINUTES=120
HANDOFF_MAX_REASSURANCES_PER_DAY=3

# Newsletter coupon may be mentioned only if the owner turns this on (v1.1)
NEWSLETTER_COUPON_ENABLED=false
