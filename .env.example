# Copy to .env for local runs. Never commit real values.

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Owner's personal WhatsApp number, international format without "+" (e.g. 972501234567)
OWNER_WHATSAPP_NUMBER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Shopify (Admin API access token with read_orders only)
SHOPIFY_STORE=avora-il.myshopify.com
SHOPIFY_ACCESS_TOKEN=

PORT=3000

# ---- Optional ----
# NODE_ENV=production            # hides message bodies in logs
# WHATSAPP_DRY_RUN=true          # log outgoing messages instead of sending
# WHATSAPP_GRAPH_VERSION=v23.0
# CLAUDE_EFFORT=low              # low | medium | high | none
# CLAUDE_MAX_TOKENS=2000
# SHOPIFY_API_VERSION=2026-07
# OWNER_NOTIFY_TEMPLATE=         # Meta-approved utility template for owner alerts (see README)
